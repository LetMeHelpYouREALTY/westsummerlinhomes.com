# Environment variables for Vercel (set in project dashboard — never commit secrets)
# FUB_API_KEY=your_follow_up_boss_api_key
# GSC_VERIFICATION=your_google_search_console_verification_token
# NEXT_PUBLIC_IMAGE_CDN_URL=https://cdn.westsummerlinhomes.com

# Google Maps Platform (amenity map on /amenities.html — restrict key by HTTP referrer in Google Cloud)
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_maps_javascript_api_key
# NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=optional_map_id_for_advanced_markers
# GOOGLE_MAPS_API_KEY=alias_used_by_/api/maps-config_if_NEXT_PUBLIC_not_set
# GOOGLE_MAPS_MAP_ID=optional_alias_for_map_id

# MCP / API keys (set in shell profile or Cursor cloud secrets — never commit)
# V0_API_KEY=your_v0_api_key
# GOOGLE_API_KEY=your_google_pagespeed_insights_api_key
# github=your_github_personal_access_token
# VERCEL_TOKEN=your_vercel_cli_token
